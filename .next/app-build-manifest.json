{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/loading.js"
    ],
    "/(root)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(root)/layout.js"
    ],
    "/(root)/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(root)/error.js"
    ],
    "/(root)/startup/[id]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(root)/startup/[id]/page.css",
      "static/chunks/app/(root)/startup/[id]/page.js"
    ],
    "/studio/[[...tool]]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/studio/[[...tool]]/page.css",
      "static/chunks/app/studio/[[...tool]]/page.js"
    ],
    "/(root)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(root)/page.js"
    ],
    "/api/auth/[...nextauth]/route": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/api/auth/[...nextauth]/route.js"
    ],
    "/(root)/startup/create/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(root)/startup/create/page.css",
      "static/chunks/app/(root)/startup/create/page.js"
    ]
  }
}